PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Use a long random string in production.
JWT_SECRET=dev_super_secret_change_me
JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE_MS=86400000
BCRYPT_SALT_ROUNDS=10

# Postgres connection string — copy to .env and fill in your own credentials.
# Never commit real credentials; .env is gitignored.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sevasahayog?schema=public

# FastAPI service that classifies feedback themes and sentiment
AI_SERVICE_URL=http://localhost:8000
